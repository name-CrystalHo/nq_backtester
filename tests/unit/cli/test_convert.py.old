                ("20250328.csv", "L1;1;20240315000002;5150000;18125.50;5;0;;\n" * 50),
            ]
            
            for filename, content in files_data:
                csv_file = csv_dir / filename
                csv_file.write_text(content)
            
            # Mock converter with realistic timing
            mock_converter = MagicMock()
            mock_converter.convert.return_value = {'status': 'success', 'rows': 100}
