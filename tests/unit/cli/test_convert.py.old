                    assert result.exit_code == 0
        finally:
            csv_path.unlink()


class TestNinjaTraderConvert:
    """Test ninjatrader-convert command functionality."""
    
    def test_ninjatrader_convert_help(self):
        """Test ninjatrader-convert command help."""
        runner = CliRunner()
        result = runner.invoke(convert_group, ['ninjatrader-convert', '--help'])
        
        assert result.exit_code == 0
        assert 'Convert NinjaTrader CSV data to Parquet' in result.output
        assert '--filter' in result.output
        assert '--dry-run' in result.output
        assert '--source' in result.output
        assert '--output' in result.output
    
    def test_ninjatrader_convert_nonexistent_source(self):
        """Test ninjatrader-convert with non-existent source directory."""
        runner = CliRunner()
        result = runner.invoke(
            convert_group,
            ['ninjatrader-convert', '--source', '/non/existent/path'],
            obj={'verbose': False, 'quiet': False}
        )
        
        # Click returns exit code 2 for invalid path arguments
        assert result.exit_code == 2
    
    @patch('src.backtester.cli.commands.convert.Path.rglob')
    @patch('src.backtester.cli.commands.convert.Path.exists')
    def test_ninjatrader_convert_no_files_found(self, mock_exists, mock_rglob):
        """Test ninjatrader-convert when no CSV files are found."""
        mock_exists.return_value = True
        mock_rglob.return_value = []  # No files found
        
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                ['ninjatrader-convert', '--source', str(source_path), '--filter', 'NQ SEP25'],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            assert 'No CSV files found matching the criteria' in result.output
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_dry_run(self, mock_converter_class):
        """Test ninjatrader-convert in dry run mode."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            
            # Create mock CSV files
            csv_files = []
            for i in range(3):
                csv_dir = source_path / f"NQ SEP25"
                csv_dir.mkdir(parents=True, exist_ok=True)
                csv_file = csv_dir / f"2025090{i}.csv"
                csv_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
                csv_files.append(csv_file)
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert', 
                    '--source', str(source_path),
                    '--filter', 'NQ SEP25',
                    '--dry-run'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            assert 'DRY RUN: Would convert' in result.output
            assert 'Found 3 CSV files' in result.output
            
            # Should create converter for streaming analysis but not call convert()
            mock_converter_class.assert_called_once_with(chunk_size=100000)
            mock_converter_instance = mock_converter_class.return_value
            
            # Should not call the actual convert method
            assert not hasattr(mock_converter_instance.convert, 'called') or not mock_converter_instance.convert.called
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_with_filter(self, mock_converter_class):
        """Test ninjatrader-convert with regex filter."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            output_path = Path(temp_dir) / "output"
            
            # Create mock CSV files - some matching filter, some not
            # Files that should match "NQ SEP25" filter
            nq_dir = source_path / "NQ SEP25"
            nq_dir.mkdir(parents=True, exist_ok=True)
            (nq_dir / "20250901.csv").write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
            (nq_dir / "20250902.csv").write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
            
            # Files that should NOT match filter
            es_dir = source_path / "ES SEP25"
            es_dir.mkdir(parents=True, exist_ok=True)
            (es_dir / "20250901.csv").write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
            
            # Mock converter
            mock_converter = MagicMock()
            mock_converter.convert.return_value = {'status': 'success', 'rows': 1}
            mock_converter_class.return_value = mock_converter
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--output', str(output_path),
                    '--filter', 'NQ SEP25',
                    '--force'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            assert 'Found 2 CSV files' in result.output  # Only NQ files should match
            assert 'conversion completed' in result.output
            
            # Should have called convert twice (for the 2 NQ files)
            assert mock_converter.convert.call_count == 2
    
    def test_ninjatrader_convert_invalid_regex(self):
        """Test ninjatrader-convert with invalid regex pattern."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--filter', '[invalid regex'  # Invalid regex pattern
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            assert 'Invalid regex pattern' in result.output
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_large_operation_confirm(self, mock_converter_class):
        """Test ninjatrader-convert confirmation for large operations."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            
            # Create a large mock CSV file (simulate >10GB by mocking stat)
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            csv_file = csv_dir / "large_file.csv"
            csv_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
            
            # Create a mock stat result
            mock_stat_result = MagicMock()
            mock_stat_result.st_size = 15 * 1024**3  # 15GB
            
            # More targeted mocking - only mock the specific file's stat
            original_stat = Path.stat
            def mock_stat_func(self, *args, **kwargs):
                if self.name == 'large_file.csv':
                    return mock_stat_result
                return original_stat(self, *args, **kwargs)
            
            with patch.object(Path, 'stat', mock_stat_func):
                runner = CliRunner()
                # Use CliRunner input to simulate user saying 'n' (no) to confirmation
                result = runner.invoke(
                    convert_group,
                    [
                        'ninjatrader-convert',
                        '--source', str(source_path),
                        '--filter', 'NQ SEP25'
                    ],
                    obj={'verbose': False, 'quiet': False},
                    input='n\n'  # User says no to confirmation
                )
                
                assert result.exit_code == 0
                assert 'Large operation' in result.output
                assert 'Operation cancelled' in result.output
                # Should not convert if user cancelled
                mock_converter_class.assert_not_called()
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_force_skip_confirmation(self, mock_converter_class):
        """Test ninjatrader-convert with force flag skips confirmation."""
