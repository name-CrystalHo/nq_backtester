    def test_ninjatrader_convert_dry_run_with_parquet_structure(self):
        """Test ninjatrader-convert dry-run shows expected parquet structure."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            output_path = Path(temp_dir) / "output"
            
            # Create multiple mock CSV files with different sizes
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            
            # Create files with mock content and sizes
            files_data = [
                ("20250327.csv", "L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 1000),  # ~50KB
                ("20250328.csv", "L1;1;20240315000002;5150000;18125.50;5;0;;\n" * 2000),  # ~100KB  
                ("20250329.csv", "L1;1;20240315000003;5150000;18125.75;5;0;;\n" * 500),   # ~25KB
            ]
            
            for filename, content in files_data:
                csv_file = csv_dir / filename
                csv_file.write_text(content)
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--output', str(output_path), 
                    '--filter', 'NQ SEP25',
                    '--dry-run'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            
            # Verify dry-run output includes structure information
            assert 'DRY RUN:' in result.output
            assert 'Would convert 3 files' in result.output
            assert 'Expected Parquet Structure:' in result.output
            assert 'Output Directory:' in result.output
            assert 'NQ SEP25/' in result.output
            
            # Verify parquet file names are shown
            assert '20250327.parquet' in result.output
            assert '20250328.parquet' in result.output  
            assert '20250329.parquet' in result.output
            
            # Verify estimated size information
            assert 'Estimated Parquet Size:' in result.output
            assert 'MB)' in result.output  # Should show file sizes
            
            # Should not actually convert files
            assert not (output_path / "NQ SEP25" / "20250327.parquet").exists()
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_progress_bar_information(self, mock_converter_class):
        """Test ninjatrader-convert shows detailed progress information."""
