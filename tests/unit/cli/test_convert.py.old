            assert 'Processing rate:' in result.output
            assert 'Expected compression:' in result.output
            
            # Should have converted both files
            assert mock_converter.convert.call_count == 2
    
    def test_ninjatrader_convert_adaptive_streaming_dry_run(self):
        """Test ninjatrader-convert dry-run shows adaptive streaming decisions."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            
            # Create CSV files with different sizes to test streaming decisions
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            
            # Small file - should use regular mode
            small_file = csv_dir / "20250327.csv"
            small_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 100)  # ~5KB
            
            # Large file - should use streaming mode  
            large_file = csv_dir / "20250328.csv"
            large_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 50000)  # ~2.5MB
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--filter', 'NQ SEP25',
                    '--dry-run',
                    '--streaming-threshold', '1'  # Low threshold to force streaming decisions
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            
            # Verify adaptive streaming information is shown
            assert 'Adaptive streaming threshold:' in result.output
            assert 'Streaming mode:' in result.output  
            assert 'Regular mode:' in result.output
            
            # Should show processing mode indicators
            assert ('🌊' in result.output or '📄' in result.output)  # At least one mode indicator
            assert ('stream' in result.output or 'regular' in result.output)  # Mode text
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_performance_options(self, mock_converter_class):
        """Test ninjatrader-convert with performance optimization options."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            output_path = Path(temp_dir) / "output"
            
            # Create mock CSV files
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            
            files_data = [
                ("20250327.csv", "L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 1000),
                ("20250328.csv", "L1;1;20240315000002;5150000;18125.50;5;0;;\n" * 1000),
            ]
            
            for filename, content in files_data:
                csv_file = csv_dir / filename
                csv_file.write_text(content)
            
            # Mock converter
            mock_converter = MagicMock()
            mock_converter.convert.return_value = {'status': 'success', 'rows': 1000}
            mock_converter_class.return_value = mock_converter
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--output', str(output_path),
                    '--filter', 'NQ SEP25',
                    '--parallel', '2',
                    '--streaming-threshold', '50',
                    '--chunk-size', '200000',
                    '--force'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            
            # Verify performance options are applied
            assert 'workers: 2' in result.output
            assert 'conversion completed' in result.output
            assert 'Parallel workers: 2' in result.output
            
            # Verify converter was configured with performance settings
            mock_converter_instance = mock_converter_class.return_value
            assert mock_converter_instance.streaming_threshold_mb == 50
            
            # Should have converted both files
            assert mock_converter.convert.call_count == 2
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    @patch('psutil.virtual_memory')
    @patch('os.cpu_count')
    def test_ninjatrader_convert_adaptive_workers_auto_detect(self, mock_cpu_count, mock_memory, mock_converter_class):
        """Test ninjatrader-convert with adaptive worker auto-detection."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            output_path = Path(temp_dir) / "output"
            
            # Mock system resources
            mock_cpu_count.return_value = 8  # 8 CPU cores
            mock_memory_info = MagicMock()
            mock_memory_info.total = 16 * 1024**3  # 16GB total RAM
            mock_memory_info.available = 12 * 1024**3  # 12GB available RAM
            mock_memory.return_value = mock_memory_info
            
            # Create 6 mock CSV files (should result in 6 workers)
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            
            for i in range(6):
                csv_file = csv_dir / f"20250{300 + i}.csv"
                csv_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 100)
            
            # Mock converter
            mock_converter = MagicMock()
            mock_converter.convert.return_value = {'status': 'success', 'rows': 100}
            mock_converter_class.return_value = mock_converter
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--output', str(output_path),
                    '--filter', 'NQ SEP25',
                    '--parallel', '0',  # Auto-detect
                    '--force'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            
            # Should show adaptive worker detection
            assert 'System resources:' in result.output
            assert 'Auto-detected optimal workers:' in result.output
            assert '6' in result.output  # Should detect 6 workers (limited by file count)
            
            # Should have converted all files
            assert mock_converter.convert.call_count == 6
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_ninjatrader_convert_manual_workers_override(self, mock_converter_class):
        """Test that manual worker count overrides auto-detection."""
        with tempfile.TemporaryDirectory() as temp_dir:
            source_path = Path(temp_dir)
            output_path = Path(temp_dir) / "output"
            
            # Create mock CSV files
            csv_dir = source_path / "NQ SEP25"
            csv_dir.mkdir(parents=True, exist_ok=True)
            
            for i in range(4):
                csv_file = csv_dir / f"20250{300 + i}.csv"
                csv_file.write_text("L1;1;20240315000001;5150000;18125.25;5;0;;\n" * 100)
            
            # Mock converter
            mock_converter = MagicMock()
            mock_converter.convert.return_value = {'status': 'success', 'rows': 100}
            mock_converter_class.return_value = mock_converter
            
            runner = CliRunner()
            result = runner.invoke(
                convert_group,
                [
                    'ninjatrader-convert',
                    '--source', str(source_path),
                    '--output', str(output_path),
                    '--filter', 'NQ SEP25',
                    '--parallel', '2',  # Manual override
                    '--force'
                ],
                obj={'verbose': False, 'quiet': False}
            )
            
            assert result.exit_code == 0
            
            # Should NOT show auto-detection when manual count is specified
            assert 'Auto-detected optimal workers:' not in result.output
            assert 'workers: 2' in result.output  # Should show manual worker count