"""
Unit tests for CLI convert commands.

Tests the ninjatrader convert command that converts NinjaTrader CSV files to Parquet.
"""

import pytest
import tempfile
from pathlib import Path
from unittest.mock import patch, MagicMock, mock_open
from click.testing import CliRunner
import polars as pl

from src.backtester.cli.commands.convert import convert_group


class TestConvertCommands:
    """Test convert command functionality."""
    
    def setUp(self):
        """Set up test fixtures."""
        self.runner = CliRunner()
    
    def test_convert_help(self):
        """Test convert command help."""
        runner = CliRunner()
        result = runner.invoke(convert_group, ['--help'])
        
        assert result.exit_code == 0
        assert 'Convert between CSV and Parquet formats' in result.output
    
    def test_ninjatrader_help(self):
        """Test ninjatrader command help."""
        runner = CliRunner()
        result = runner.invoke(convert_group, ['ninjatrader', '--help'])
        
        assert result.exit_code == 0
        assert 'Convert NinjaTrader CSV files' in result.output
        assert '--source' in result.output
        assert '--output' in result.output
        assert '--instrument' in result.output
    
    @patch('src.backtester.cli.commands.convert.convert_csv_to_parquet')
    def test_ninjatrader_success(self, mock_convert):
        """Test successful NinjaTrader conversion."""
        # Mock converter function
        mock_convert.return_value = {
            'total_files': 5,
            'processed': 5,
            'skipped': 0,
            'errors': 0,
            'total_rows': 1000000,
            'total_l1': 900000,
            'total_l2': 100000,
            'total_size_mb': 150.5,
            'failed_files': []
        }
        
        runner = CliRunner()
        with tempfile.TemporaryDirectory() as temp_dir:
            result = runner.invoke(
                convert_group, 
                ['ninjatrader', '--output', temp_dir, '--instrument', 'NQ SEP25']
            )
            
            assert result.exit_code == 0
            assert 'Conversion completed successfully' in result.output
            assert 'Total files found: 5' in result.output
            assert 'Successfully processed: 5' in result.output
            mock_convert.assert_called_once()
    
    @patch('src.backtester.cli.commands.convert.convert_csv_to_parquet')
    def test_ninjatrader_failure(self, mock_convert):
        """Test failed NinjaTrader conversion."""
        # Mock converter to raise exception
        mock_convert.side_effect = Exception("Conversion error")
        
        runner = CliRunner()
        with tempfile.TemporaryDirectory() as temp_dir:
            result = runner.invoke(
                convert_group,
                ['ninjatrader', '--output', temp_dir]
            )
            
            assert result.exit_code != 0
            assert 'Conversion failed' in result.output
        
        try:
            with tempfile.TemporaryDirectory() as temp_dir:
                output_path = Path(temp_dir) / "output.parquet"
                
                # Mock converter failure
                mock_converter = MagicMock()
                mock_converter.convert.return_value = {
                    'status': 'error',
                    'error': 'Test error message'
                }
                mock_converter_class.return_value = mock_converter
                
                runner = CliRunner()
                result = runner.invoke(
                    convert_group,
                    ['csv-to-parquet', str(csv_path), str(output_path)],
                    obj={'verbose': False, 'quiet': False}
                )
                
                assert result.exit_code == 0  # Click doesn't exit on our errors
                assert 'Conversion failed' in result.output
                assert 'Test error message' in result.output
        finally:
            csv_path.unlink()
    
    def test_csv_to_parquet_nonexistent_input(self):
        """Test CSV to Parquet with non-existent input file."""
        runner = CliRunner()
        result = runner.invoke(
            convert_group,
            ['csv-to-parquet', '/non/existent/file.csv', '/tmp/output.parquet'],
            obj={'verbose': False, 'quiet': False}
        )
        
        # Click should exit with code 2 for invalid file parameter
        assert result.exit_code == 2
    
    @patch('src.backtester.cli.commands.convert.CSVToParquetConverter')
    def test_csv_to_parquet_existing_output_no_force(self, mock_converter_class):
        """Test CSV to Parquet with existing output file without force."""
        with tempfile.NamedTemporaryFile(mode='w', suffix='.csv', delete=False) as csv_file:
            csv_file.write("L1;1;20240315000001;5150000;18125.25;5;0;;\n")
            csv_file.flush()
            csv_path = Path(csv_file.name)
        
        try:
            with tempfile.NamedTemporaryFile(suffix='.parquet', delete=False) as output_file:
                output_path = Path(output_file.name)
                
                runner = CliRunner()
                result = runner.invoke(
                    convert_group,
                    ['csv-to-parquet', str(csv_path), str(output_path)],
                    obj={'verbose': False, 'quiet': False}
                )
                
                assert result.exit_code == 0
                assert 'already exists' in result.output
                assert 'Use --force' in result.output
            
            output_path.unlink()
        finally:
            csv_path.unlink()
    
